include README.md README.zh-CN.md
include .gitignore .gitattributes
recursive-include .github *.yml
recursive-include docs *.md
recursive-include docs/assets *.png *.svg *.pdf
recursive-include examples *.py *.md *.csv *.json
include examples/merfish/data/training-counts.npz
include examples/merfish/data/library-totals.npy
include examples/merfish/data/measurement-counts.npz
recursive-include tests *.py *.json
recursive-include src/panelaugment/resources *.json *.csv *.tsv
global-exclude *.py[cod] .DS_Store
